{
  "version": "0.2.0",
  "configurations": [
{
      "name": "Electron: Main",
      "type": "node",
      "request": "attach",
      "port": 5858,
      "restart": true,
      "timeout": 30000,
      "outFiles": ["${workspaceFolder}/.erb/dll/**/*.js"],
      "sourceMapPathOverrides": {
        "webpack://electron-react-boilerplate/./src/main/*": "${workspaceFolder}/src/main/*",
        "webpack://electron-react-boilerplate/src/main/*": "${workspaceFolder}/src/main/*",
        "webpack:///./src/main/*": "${workspaceFolder}/src/main/*",
        "webpack:///src/main/*": "${workspaceFolder}/src/main/*",
        "webpack:///*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Electron: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}",
      "timeout": 15000
    }
  ],
  "compounds": [
    {
      "name": "Electron: All",
      "configurations": ["Electron: Main", "Electron: Renderer"]
    }
  ]
}
